{
	"name": "dkeeper_frontend",
	"version": "0.4.0",
	"description": "DKeeper: an Internet Computer notes app with a Motoko canister backend",
	"keywords": [
		"Internet Computer",
		"Motoko",
		"ICP",
		"React"
	],
	"scripts": {
		"build": "webpack",
		"prebuild": "dfx generate",
		"start": "webpack serve --mode development --env development",
		"prestart": "npm run copy:types",
		"deploy:local": "dfx deploy --network=local",
		"deploy:ic": "dfx deploy --network=ic",
		"generate": "dfx generate dkeeper_backend",
		"copy:types": "rsync -avr .dfx/$(echo ${DFX_NETWORK:-'**'})/canisters/** --exclude='assets/' --exclude='idl/' --exclude='*.wasm' --delete src/declarations"
	},

	"dependencies": {
		"@dfinity/agent": "^0.19.2",
		"@dfinity/candid": "^0.19.2",
		"@dfinity/principal": "^0.19.2",
		"lucide-react": "^1.21.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"assert": "2.0.0",
		"buffer": "6.0.3",
		"copy-webpack-plugin": "^11.0.0",
		"css-loader": "^6.5.1",
		"dotenv": "^16.0.3",
		"events": "3.3.0",
		"html-webpack-plugin": "^5.6.7",
		"process": "0.11.10",
		"stream-browserify": "3.0.0",
		"style-loader": "^3.3.1",
		"terser-webpack-plugin": "^5.3.3",
		"ts-loader": "^9.6.1",
		"typescript": "^5.9.3",
		"util": "0.12.4",
		"webpack": "^5.107.2",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.2.5"
	},
	"engines": {
		"node": ">=18"
	},
	"browserslist": [
		"last 2 chrome version",
		"last 2 firefox version",
		"last 2 safari version",
		"last 2 edge version"
	]
}